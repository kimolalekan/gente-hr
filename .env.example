# ─── Local development environment ──────────────────────────────────────────
# Copy to .env.local and adjust.

# Postgres connection — REQUIRED for login. OTP codes are stored only in the
# database (no in-memory fallback). Start the DB and apply the schema:
#   docker compose up -d        # Postgres 16 on localhost:5432
#   pnpm db:migrate && pnpm db:seed
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gente

# ─── Session cookie signing ─────────────────────────────────────────────────
# Sessions are stateless, signed httpOnly cookies (not stored in the DB or
# localStorage). Use a long random value in production.
AUTH_SESSION_SECRET=dev-secret-change-me-in-production

# ─── Passwordless auth (OTP) ────────────────────────────────────────────────
# Delivery provider. Set a key to send codes by email (Resend API, no extra
# dependency). Without it, codes are printed to the server console — the
# "console provider" (development).
RESEND_API_KEY=
RESEND_FROM=Gente <onboarding@resend.dev>

# ─── Seeder (pnpm db:seed) ──────────────────────────────────────────────────
SEED_TENANT_ID=00000000-0000-0000-0000-000000000001
SEED_TENANT_SLUG=acme
SEED_TENANT_NAME=Acme Inc.
SEED_GLOBEX_TENANT_ID=00000000-0000-0000-0000-000000000004
# Admin user (gets admin access to ALL tenants)
SEED_USER_ID=00000000-0000-0000-0000-000000000002
SEED_USER_EMAIL=admin@gente.dev
SEED_USER_NAME=Ada Admin
# HR user (primary tenant only)
SEED_HR_USER_EMAIL=priya.sharma@gente.dev
SEED_HR_USER_NAME=Priya Sharma
# Staff user (primary tenant only)
SEED_STAFF_USER_EMAIL=marco.rossi@gente.dev
SEED_STAFF_USER_NAME=Marco Rossi

# ─── Fallback tenant for unauthenticated requests (login page theme) ────────
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
